{
  "name": "discord-entaku-overlay",
  "version": "0.1.0-rc.15",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun run scripts/build-web.ts && bun run src/cli.ts --demo",
    "start": "bun run src/cli.ts",
    "doctor": "bun run src/cli.ts --doctor",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test tests",
    "build:web": "bun run scripts/build-web.ts",
    "build:exe": "bun run scripts/build-executable.ts",
    "package:windows": "bun run scripts/package-windows.ts",
    "verify:package": "bun run scripts/verify-package.ts",
    "test:e2e": "bun run build:web && playwright test",
    "smoke:exe": "bun run scripts/smoke-executable.ts",
    "probe:vc-chat": "bun run scripts/probe-vc-chat.ts",
    "build:probe": "bun run scripts/build-vc-chat-probe.ts",
    "bench:domain": "bun run scripts/benchmark-domain.ts",
    "bench:render": "bun run scripts/benchmark-render.ts",
    "test:ui": "bun run build:web && playwright test e2e/rc15-controls.spec.ts e2e/presets-seats.spec.ts e2e/vc-chat.spec.ts e2e/gaussian-avatars.spec.ts",
    "test:render": "bun run build:web && playwright test e2e/render-regressions.spec.ts e2e/post-effects.spec.ts e2e/studio-materials.spec.ts e2e/exposure.spec.ts e2e/split-screen.spec.ts e2e/gaussian-render.spec.ts",
    "fixtures:gaussian": "bun run scripts/generate-gaussian-fixtures.ts",
    "test:gaussian": "bun test tests/unit/gaussian-*.test.ts tests/integration/gaussian-*.test.ts",
    "test:gaussian:browser": "bun run build:web && playwright test e2e/gaussian-*.spec.ts"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "fflate": "0.8.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
