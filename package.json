{
  "name": "discord-entaku-overlay",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun run scripts/build-web.ts && bun run src/cli.ts --demo",
    "start": "bun run src/cli.ts",
    "doctor": "bun run src/cli.ts --doctor",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test tests",
    "build:web": "bun run scripts/build-web.ts",
    "build:exe": "bun run scripts/build-executable.ts",
    "package:windows": "bun run scripts/package-windows.ts",
    "verify:package": "bun run scripts/verify-package.ts",
    "test:e2e": "bun run build:web && playwright test",
    "smoke:exe": "bun run scripts/smoke-executable.ts"
  },
  "dependencies": {
    "three": "0.187.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
